# /etc/nginx/sites-available/quiaditca
# Sous-domaine du jeu : jeu.samuel-josephmyrtil.fr
# Installation : sudo ln -s /etc/nginx/sites-available/quiaditca /etc/nginx/sites-enabled/
#        sudo nginx -t && sudo systemctl reload nginx
#        sudo certbot --nginx -d jeu.samuel-josephmyrtil.fr   (ajoute le bloc HTTPS)

server {
    listen 80;
    server_name jeu.samuel-josephmyrtil.fr;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;

        # Indispensable pour les WebSockets (Socket.io)
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Une connexion WebSocket reste ouverte toute la partie
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
